{
  "name": "northern-editor",
  "version": "1.0.1",
  "private": true,
  "description": "Northern Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu --disable-gpu-compositing --use-gl=swiftshader",
    "dev": "electron . --dev --no-sandbox --disable-gpu --disable-gpu-compositing --use-gl=swiftshader",
    "check": "node scripts/check-js.js",
    "test": "node test/smoke.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "keywords": [
    "aurora3ds",
    "auroraos",
    "auric",
    "electron",
    "3ds"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aurora3ds.studio",
    "productName": "Northern Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!.git"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "Aurora",
        "to": "Aurora"
      },
      {
        "from": "emulator",
        "to": "emulator"
      }
    ]
  }
}
